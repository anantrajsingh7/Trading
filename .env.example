# Copy to .env and fill in. .env is git-ignored and MUST NEVER be committed.
# All credentials are read from the environment only - never from source, config or logs.

# --- Bitvavo API (OPTIONAL) ---------------------------------------------------
# Everything in Phase 1-9 (research + backtesting) uses PUBLIC endpoints only and
# needs NO credentials at all. Provide a key only if you want account-specific
# maker/taker fees or authenticated rate limits.
#
# The key you create MUST be READ-ONLY:
#   - "View information"  -> ENABLE
#   - "Trade"             -> DISABLE
#   - "Withdraw funds"    -> DISABLE  (never enable this, for any reason)
# Optionally restrict the key to your IP address in the Bitvavo UI.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Bitvavo operator window in ms; 0 uses the client default.
BITVAVO_ACCESS_WINDOW_MS=10000

# --- Live trading kill switch -------------------------------------------------
# Live order execution is disabled by default and requires BOTH this variable and
# the `live_trading.enabled` flag in config/paper_trading.yaml to be set.
# Leave this as "false" unless you have deliberately decided otherwise.
ALLOW_LIVE_TRADING=false

# --- Alerts (all optional; leave blank to disable) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Paths (optional overrides) ----------------------------------------------
BMA_DATA_DIR=data
BMA_LOG_LEVEL=INFO
