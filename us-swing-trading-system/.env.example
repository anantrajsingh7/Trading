# ============================================================
# US Swing Trading System – Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit the real .env file to version control.
# ============================================================

# -----------------------------------------------------------
# yfinance (default provider – no key needed)
# -----------------------------------------------------------
# yfinance is the default data provider and requires no API key.
# Leave the line below commented unless you switch providers.
# DATA_PROVIDER=yfinance

# -----------------------------------------------------------
# Polygon.io (optional – higher rate limits, real-time data)
# Get a free key at https://polygon.io/
# -----------------------------------------------------------
# POLYGON_API_KEY=your_polygon_api_key_here

# -----------------------------------------------------------
# Alpaca Markets (optional – paper/live trading data)
# Get keys at https://app.alpaca.markets/
# -----------------------------------------------------------
# ALPACA_API_KEY=your_alpaca_key_here
# ALPACA_SECRET_KEY=your_alpaca_secret_here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------
# Alpha Vantage (optional – fundamental + technical data)
# Get a free key at https://www.alphavantage.co/support/#api-key
# -----------------------------------------------------------
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# -----------------------------------------------------------
# Earnings calendar (optional – to skip stocks near earnings)
# Uses Nasdaq earnings API by default (no key needed).
# Set EARNINGS_PROVIDER=alphavantage to use Alpha Vantage.
# -----------------------------------------------------------
# EARNINGS_PROVIDER=nasdaq
