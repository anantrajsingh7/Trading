# ============================================================
# Quant Platform — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# Data providers (optional — yfinance needs no key)
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# Gmail SMTP delivery (for daily dashboard email)
# Get App Password: myaccount.google.com/security → App passwords
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ALERT_EMAIL_TO=anantrajsingh7@gmail.com
DASHBOARD_AUTO_EMAIL=true

# Other alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
SENDGRID_API_KEY=
